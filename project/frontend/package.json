{
  "name": "@closeloop/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:widget": "pnpm --filter @closeloop/widget dev",
    "build": "pnpm --filter @closeloop/widget build && next build",
    "build:widget": "pnpm --filter @closeloop/widget build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "magic-string": "0.30.17"
    }
  }
}
