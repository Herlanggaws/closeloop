{
  "name": "@closeloop/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "dev:widget": "pnpm --filter @closeloop/widget dev",
    "build": "pnpm --filter @closeloop/widget build && next build",
    "build:widget": "pnpm --filter @closeloop/widget build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "tsx --test src/lib/inviteEmails.test.ts src/lib/site.test.ts src/lib/dogfood-widget.test.ts src/lib/auth-redirect.test.ts src/lib/widget-events.test.ts src/lib/tours.test.ts src/lib/widget-install.test.ts src/components/SaidloopLogo.test.ts src/components/Skeleton.test.tsx src/lib/plans.test.ts src/lib/onboarding-checklist.test.ts src/lib/seats.test.ts src/lib/repos.test.ts src/lib/billing.test.ts",
    "test:e2e": "playwright test e2e/reports.spec.ts",
    "test:e2e:marketing": "playwright test e2e/marketing.spec.ts",
    "test:e2e:ui": "playwright test e2e/reports.spec.ts --ui"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.29",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rrweb-player": "2.0.0-alpha.20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "magic-string": "0.30.17",
      "postcss": ">=8.5.23",
      "minimatch@>=7.0.0 <11.0.1": ">=11.0.1"
    }
  }
}
