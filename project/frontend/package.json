{
  "name": "@closeloop/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:widget": "pnpm --filter @closeloop/widget dev",
    "build": "pnpm --filter @closeloop/widget build && next build",
    "build:widget": "pnpm --filter @closeloop/widget build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "tsx --test src/lib/inviteEmails.test.ts src/lib/site.test.ts",
    "test:e2e": "playwright test e2e/reports.spec.ts",
    "test:e2e:marketing": "playwright test e2e/marketing.spec.ts",
    "test:e2e:ui": "playwright test e2e/reports.spec.ts --ui"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "magic-string": "0.30.17"
    }
  }
}
