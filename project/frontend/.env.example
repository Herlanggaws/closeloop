# Closeloop Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional CDN base for the widget script (no trailing slash). Empty = same-origin /w.js
# Example: https://cdn.closeloop.dev
NEXT_PUBLIC_WIDGET_CDN_URL=

# Embed Saidloop on saidloop.com (dogfood). Set 0/false to disable locally.
# NEXT_PUBLIC_DOGFOOD_WIDGET=0


# Google OAuth Client ID (optional override; if blank, fetched dynamically from backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Tag Manager container ID (defaults to GTM-KZJ4GG9R in code)
NEXT_PUBLIC_GTM_ID=GTM-KZJ4GG9R
