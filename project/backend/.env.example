DATABASE_URL=postgres://localhost:5432/closeloop?sslmode=disable
JWT_SECRET=dev-jwt-secret-change-me-in-production
# Optional dedicated key for encrypting integration tokens at rest (defaults to JWT_SECRET if empty):
INTEGRATION_ENCRYPTION_KEY=
STORAGE_ROOT=../.data/uploads
API_URL=http://localhost:8080
WEB_URL=http://localhost:3000
API_ADDR=:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Saidloop <noreply@saidloop.dev>"
# Auto PR stays off until the runner writes real fixes (D-24). true lets POST /api/tickets/:id/autopr run.
AUTOPR_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=saidloop-auto-pr
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Or path to the .pem downloaded from GitHub App settings (never commit the file):
# GITHUB_APP_PRIVATE_KEY_PATH=./.secrets/saidloop-auto-pr.private-key.pem

# Slack "Add to Slack" (F8). Slack app with OAuth scope incoming-webhook and
# redirect URL ${API_URL}/api/integrations/slack/callback. Empty = paste a webhook URL instead.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# Billing (M5). Never commit real values. Empty = checkout answers 503 and plans are
# switched manually. Setting POLAR_ACCESS_TOKEN closes the manual switch to paid plans.
# Token scopes: checkouts:write, customer_sessions:write.
POLAR_ACCESS_TOKEN=
# Webhook endpoint: ${API_URL}/api/webhooks/billing
POLAR_WEBHOOK_SECRET=
# sandbox | production (empty = sandbox). Token, secret and product IDs differ per server.
POLAR_SERVER=
POLAR_PRODUCT_INDIE_MONTHLY=
POLAR_PRODUCT_INDIE_YEARLY=
POLAR_PRODUCT_STUDIO_MONTHLY=
POLAR_PRODUCT_STUDIO_YEARLY=
