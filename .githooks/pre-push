#!/usr/bin/env bash
set -euo pipefail

# Block direct pushes to dev or main; all work must go through a feature branch PR.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/dev" ]]; then
    echo "ERROR: Direct push to '${remote_ref#refs/heads/}' is blocked by repository policy." >&2
    echo "Create and push a feature branch instead:" >&2
    echo "  git checkout -b feat/<your-branch-name>" >&2
    echo "  git push -u origin HEAD" >&2
    echo "Then open a Pull Request targeting 'dev' (or 'main' for releases) so Lint & Vulnerability Check runs." >&2
    exit 1
  fi
done

